# ==========================================
# Loker Environment Configuration Template
# ==========================================

# --- GitHub Configuration ---
# Note: Menggunakan autentikasi SSH key server, bukan personal access token
GITHUB_REPO_NAME=
GITHUB_AUTH_TYPE=ssh

# --- Blogger API ---
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# --- Instagram Official API ---
# Status: PENDING_META_VERIFICATION (Gunakan Official Graph API, bukan scraper)
IG_ACCESS_TOKEN=<PENDING_META_VERIFICATION>
IG_USER_ID=<PENDING>
IG_APP_ID=<PENDING>
IG_APP_SECRET=<PENDING>

# --- Midtrans Payment Gateway ---
# Status: PENDING_KTP_VERIFICATION
MIDTRANS_SERVER_KEY=<PENDING_KTP_VERIFICATION>
MIDTRANS_CLIENT_KEY=<PENDING>
MIDTRANS_IS_PRODUCTION=false

# --- Google OAuth Login ---
# Type: Web Application. Redirect URI menunggu domain/endpoint backend pasti.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=<PENDING_DOMAIN_SETUP>

# --- SMTP Configuration ---
# Menggunakan Google App Password (bukan master account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp Gateway (Fonnte API) ---
WA_GATEWAY_ENDPOINT=https://api.fonnte.com/send
WA_API_TOKEN=
ADMIN_WHATSAPP_PHONE=

# --- Google Gemini AI Engine ---
GEMINI_API_KEY=


